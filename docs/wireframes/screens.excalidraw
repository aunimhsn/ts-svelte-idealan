   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "They rise from the bottom of the screen over the dimmed bag (a bottom sheet); « Fermer », « Annuler » or a tap on the dimmed bag closes them.\n« Who voted » is a bubble under the score: a tap shows it, a second tap or a tap elsewhere hides it; the page is not dimmed.",
   "originalText": "They rise from the bottom of the screen over the dimmed bag (a bottom sheet); « Fermer », « Annuler » or a tap on the dimmed bag closes them.\n« Who voted » is a bubble under the score: a tap shows it, a second tap or a tap elsewhere hides it; the page is not dimmed.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
